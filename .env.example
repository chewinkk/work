# Canvas. Base URL is your school's Canvas address, no trailing slash.
CANVAS_BASE_URL=https://yourschool.instructure.com
CANVAS_TOKEN=paste-your-canvas-access-token-here

# The password you type to get into this app. Pick a long one.
APP_PASSWORD=change-me-to-something-long
# Random string used to sign your login cookie. Generate a new one, never share it.
SECRET_KEY=change-me-to-a-long-random-string

# ntfy push notifications. The topic name is the only thing protecting it,
# so make it long and random, like canvas-7f3a91b2c4.
NTFY_TOPIC=pick-a-long-random-topic-name
NTFY_SERVER=https://ntfy.sh

# Send the login cookie only over HTTPS. Leave this alone for Railway.
# Set it to false only if you run the app locally over plain http.
COOKIE_SECURE=true

# How often to check Canvas, in minutes.
POLL_MINUTES=30

# Your timezone. Canvas sends due dates in UTC, and without this an 11:59 PM
# deadline shows as 3:59 AM the next day. Find yours in the "TZ identifier"
# column at en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York

# Where the database and uploaded files live. On Railway this is your volume.
DATA_DIR=/data

# Give up on a submission after this many failed tries.
MAX_SUBMIT_ATTEMPTS=3

# Anthropic, for the AI Approved deck generator.
# Set this on Railway too. It is not in this file by default on purpose.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
